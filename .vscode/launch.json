{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Iniciar Ecosistema Completo (.NET Aspire Harness)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/harness/ProyectoFullstack.AppHost/bin/Debug/net10.0/ProyectoFullstack.AppHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/harness/ProyectoFullstack.AppHost",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}
