{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:\\Users\\sabri\\AppData\\Local\\Microsoft\\dotnet;${env:PATH}",
      "DOTNET_ROOT": "C:\\Users\\sabri\\AppData\\Local\\Microsoft\\dotnet",
      "DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true"
    }
  },
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/harness/ProyectoFullstack.AppHost/ProyectoFullstack.AppHost.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "frontend:build",
      "command": "npm",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "args": ["run", "build"],
      "problemMatcher": []
    },
    {
      "label": "aspire:run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/harness/ProyectoFullstack.AppHost/ProyectoFullstack.AppHost.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
